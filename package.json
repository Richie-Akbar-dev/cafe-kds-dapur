{
  "name": "cafe-kds-dapur",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "npx prisma generate && npx prisma db push --accept-data-loss 2>/dev/null && next build",
    "start": "npx prisma db push --accept-data-loss 2>/dev/null && NODE_ENV=production node .next/standalone/server.js",
    "lint": "eslint .",
    "db:push": "npx prisma db push --accept-data-loss",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate deploy",
    "postinstall": "npx prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.3.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "eslint-config-next-typescript": "^15.3.3",
    "postcss": "^8.5.4",
    "prisma": "^6.11.1",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3"
  }
}